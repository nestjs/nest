{
  "name": "@nestjs/platform-node",
  "version": "12.2.0",
  "description": "Nest - modern, fast, powerful node.js web framework (@platform-node)",
  "author": "Kamil Mysliwiec",
  "license": "MIT",
  "type": "module",
  "main": "./index.js",
  "exports": {
    ".": "./index.js",
