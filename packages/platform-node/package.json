    "fast-querystring": "1.1.2",
    "find-my-way": "9.9.0",
    "mime-types": "3.0.2",
    "multer": "2.4.0",
    "on-finished": "2.4.1",
    "path-to-regexp": "8.4.2",
    "qs": "6.15.3",
    "secure-json-parse": "4.1.0",
    "send": "1.2.1",
    "serve-static": "2.2.1",
    "tslib": "2.8.1",
    "type-is": "2.1.0"
  },
  "devDependencies": {
    "@nestjs/common": "12.2.0",
    "@nestjs/core": "12.2.0"
  },
  "peerDependencies": {
    "@nestjs/common": "^12.0.0",
