{
  "name": "webhooks",
  "version": "1.0.0",
  "description": "Outgoing and incoming webhooks with @nestjs/webhooks, @nestjs/outbox, Drizzle ORM and PostgreSQL",
  "license": "MIT",
  "scripts": {
    "build": "nest build",
    "format": "prettier --write \"src/**/*.ts\" \"partner-service/**/*.ts\" \"scripts/**/*.ts\"",
    "start": "nest start",
    "start:dev": "nest start --watch",
    "start:debug": "nest start --debug --watch",
    "start:prod": "node dist/src/main",
    "start:partner": "nest start --entryFile ../partner-service/main",
    "start:partner:prod": "node dist/partner-service/main",
    "lint": "oxlint src partner-service scripts --fix",
    "migrate": "drizzle-kit migrate"
  },
  "dependencies": {
    "@nestjs/common": "12.1.2",
    "@nestjs/core": "12.1.2",
    "@nestjs/drizzle": "0.0.1",
    "@nestjs/outbox": "0.1.1",
    "@nestjs/platform-express": "12.1.2",
    "@nestjs/webhooks": "0.0.1",
    "class-transformer": "0.5.1",
    "class-validator": "0.15.1",
    "drizzle-orm": "0.45.3",
    "pg": "8.23.1",
    "reflect-metadata": "0.2.2",
    "rxjs": "7.8.2"
  },
  "devDependencies": {
    "@nestjs/cli": "12.0.8",
    "@nestjs/schematics": "12.0.6",
    "@types/express": "5.0.6",
    "@types/node": "24.19.1",
    "@types/pg": "8.23.1",
    "drizzle-kit": "0.31.11",
    "oxlint": "1.87.0",
    "prettier": "3.9.9",
    "ts-loader": "9.6.2",
    "ts-node": "10.9.2",
    "tsconfig-paths": "4.2.0",
    "tsx": "4.23.15",
    "typescript": "6.0.3"
  },
  "type": "module"
}
