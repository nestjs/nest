{
  "name": "graphql-federation-code-first-gateway",
  "version": "1.0.0",
  "description": "Code-first Apollo Federation gateway for the users and posts subgraphs",
  "license": "MIT",
  "scripts": {
    "prebuild": "rimraf dist",
    "build": "nest build",
    "format": "prettier --write \"src/**/*.ts\" \"test/**/*.ts\"",
    "start": "nest start",
    "start:dev": "nest start --watch",
    "start:debug": "nest start --debug --watch",
    "start:prod": "node dist/main",
    "generate:supergraph": "ts-node --esm generate-supergraph.ts",
    "generate:supergraph:rover": "ts-node --esm generate-supergraph.ts --rover",
    "prestart": "npm run generate:supergraph",
    "prestart:dev": "npm run generate:supergraph",
    "lint": "oxlint src --fix",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:cov": "vitest run --coverage",
    "test:debug": "vitest --inspect-brk --no-file-parallelism",
    "test:e2e": "vitest run --config ./vitest.config.e2e.mts"
  },
  "dependencies": {
    "@apollo/gateway": "2.14.4",
    "@apollo/server": "5.5.1",
    "@nestjs/apollo": "14.2.0",
    "@nestjs/common": "12.4.2",
    "@nestjs/core": "12.4.1",
    "@nestjs/graphql": "14.2.0",
    "@nestjs/platform-express": "12.4.1",
    "graphql": "17.1.0",
    "graphql-tools": "10.0.8",
    "reflect-metadata": "0.2.2",
    "rimraf": "6.1.4",
    "rxjs": "7.8.2",
    "ts-morph": "28.0.0"
  },
  "devDependencies": {
    "@nestjs/cli": "12.0.12",
    "@nestjs/schematics": "12.0.13",
    "@nestjs/testing": "12.4.1",
    "@types/express": "5.0.6",
    "@types/node": "26.6.6",
    "@types/supertest": "7.2.1",
    "oxlint": "1.91.0",
    "prettier": "3.9.10",
    "supertest": "7.3.2",
    "ts-loader": "9.6.2",
    "ts-node": "10.9.2",
    "tsconfig-paths": "4.2.0",
    "typescript": "5.9.3",
    "vitest": "5.1.0",
    "webpack": "5.112.2"
  },
  "type": "module"
}
