{
  "name": "gateway",
  "version": "1.0.0",
  "description": "Nest TypeScript starter repository",
  "license": "MIT",
  "scripts": {
    "prebuild": "rimraf dist",
    "build": "nest build",
    "format": "prettier --write \"src/**/*.ts\" \"test/**/*.ts\"",
    "start": "nest start",
    "start:dev": "nest start --watch",
    "start:debug": "nest start --debug --watch",
    "start:prod": "node dist/main",
    "generate:supergraph": "ts-node --esm generate-supergraph.ts",
    "generate:supergraph:rover": "ts-node --esm generate-supergraph.ts --rover",
    "prestart": "npm run generate:supergraph",
    "prestart:dev": "npm run generate:supergraph",
    "lint": "oxlint src --fix",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:cov": "vitest run --coverage",
    "test:debug": "vitest --inspect-brk --no-file-parallelism",
    "test:e2e": "vitest run --config ./vitest.config.e2e.mts"
  },
  "dependencies": {
    "@apollo/gateway": "2.14.4",
    "@apollo/server": "5.5.1",
    "@nestjs/apollo": "14.0.2",
    "@nestjs/common": "12.1.0",
    "@nestjs/core": "12.1.0",
    "@nestjs/graphql": "14.0.2",
    "@nestjs/platform-express": "12.1.0",
    "graphql": "17.0.2",
    "graphql-tools": "9.0.35",
    "reflect-metadata": "0.2.2",
    "rimraf": "6.1.3",
    "rxjs": "7.8.2",
    "ts-morph": "28.0.0"
  },
  "devDependencies": {
    "@nestjs/cli": "12.0.6",
    "@nestjs/schematics": "12.0.5",
    "@nestjs/testing": "12.1.0",
    "@types/express": "5.0.6",
    "@types/node": "24.13.6",
    "@types/supertest": "7.2.1",
    "oxlint": "1.85.0",
    "prettier": "3.9.9",
    "supertest": "7.3.0",
    "ts-loader": "9.6.2",
    "ts-node": "10.9.2",
    "tsconfig-paths": "4.2.0",
    "typescript": "7.0.2",
    "vitest": "5.0.1",
    "webpack": "5.111.1"
  },
  "type": "module"
}
