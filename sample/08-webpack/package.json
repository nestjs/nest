{
  "name": "webpack",
  "version": "1.0.0",
  "description": "Hot module replacement with webpack",
  "license": "MIT",
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "build:dev": "nest build --watch --webpack --webpackPath webpack-hmr.config.cjs",
    "start": "node dist/main",
    "lint": "oxlint src --fix",
    "test": "echo 'No tests implemented yet.'",
    "test:e2e": "vitest run --config ./vitest.config.e2e.mts"
  },
  "dependencies": {
    "@nestjs/common": "12.4.1",
    "@nestjs/core": "12.4.1",
    "@nestjs/platform-express": "12.4.1",
    "reflect-metadata": "0.2.2",
    "rxjs": "7.8.2",
    "typescript": "5.9.3"
  },
  "devDependencies": {
    "@nestjs/cli": "12.0.12",
    "@nestjs/schematics": "12.0.13",
    "@types/node": "26.6.6",
    "oxlint": "1.91.0",
    "start-server-webpack-plugin": "2.2.5",
    "vitest": "5.1.0",
    "webpack": "5.112.2",
    "webpack-cli": "7.3.1",
    "webpack-node-externals": "3.0.0"
  },
  "type": "module"
}
