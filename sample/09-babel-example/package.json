{
  "name": "babel-example",
  "version": "1.0.0",
  "description": "Plain JavaScript compiled with Babel and legacy decorators",
  "license": "MIT",
  "scripts": {
    "format": "prettier --write \"**/*.js\"",
    "prebuild": "rimraf dist",
    "build": "babel src -d dist",
    "start": "npm run build && node dist/main.js",
    "start:dev": "nodemon",
    "start:prod": "node dist/main.js",
    "test": "vitest run",
    "test:cov": "vitest run --coverage",
    "test:e2e": "vitest run --config ./vitest.config.e2e.mts"
  },
  "dependencies": {
    "@nestjs/common": "12.4.2",
    "@nestjs/core": "12.4.1",
    "@nestjs/microservices": "12.4.1",
    "@nestjs/platform-express": "12.4.1",
    "@nestjs/websockets": "12.4.1",
    "reflect-metadata": "0.2.2",
    "rimraf": "6.1.4",
    "rxjs": "7.8.2"
  },
  "devDependencies": {
    "@babel/cli": "8.1.0",
    "@babel/core": "8.1.0",
    "@babel/plugin-proposal-decorators": "8.0.2",
    "@babel/preset-env": "8.0.7",
    "@nestjs/testing": "12.4.1",
    "nodemon": "3.1.14",
    "oxlint": "1.91.0",
    "prettier": "3.9.10",
    "supertest": "7.3.2",
    "vitest": "5.1.0"
  },
  "type": "module"
}
