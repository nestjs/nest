{
  "name": "nest-typescript-starter",
  "version": "1.0.0",
  "description": "Nest TypeScript starter repository",
  "license": "MIT",
  "scripts": {
    "prebuild": "rimraf dist",
    "build": "nest build",
    "format": "prettier --write \"src/**/*.ts\" \"analytics-service/**/*.ts\" \"e2e/**/*.ts\"",
    "start": "nest start",
    "start:dev": "nest start --watch",
    "start:debug": "nest start --debug --watch",
    "start:prod": "node dist/src/main",
    "start:analytics": "nest start --entryFile ../analytics-service/src/main",
    "start:analytics:prod": "node dist/analytics-service/src/main",
    "lint": "oxlint src analytics-service --fix",
    "migrate": "drizzle-kit migrate",
    "migrate:analytics": "drizzle-kit migrate --config analytics-service/drizzle.config.ts",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:cov": "vitest run --coverage",
    "test:debug": "vitest --inspect-brk --no-file-parallelism",
    "test:e2e": "vitest run --config ./vitest.config.e2e.mts"
  },
  "dependencies": {
    "@nestjs/common": "12.1.1",
    "@nestjs/core": "12.1.1",
    "@nestjs/drizzle": "0.0.1",
    "@nestjs/microservices": "12.1.1",
    "@nestjs/outbox": "0.0.1",
    "@nestjs/platform-express": "12.1.1",
    "drizzle-orm": "0.45.3",
    "pg": "8.23.0",
    "reflect-metadata": "0.2.2",
    "rimraf": "6.1.3",
    "rxjs": "7.8.2"
  },
  "devDependencies": {
    "@electric-sql/pglite": "0.5.8",
    "@nestjs/cli": "12.0.8",
    "@nestjs/schematics": "12.0.6",
    "@nestjs/testing": "12.1.1",
    "@types/express": "5.0.6",
    "@types/node": "24.19.0",
    "@types/pg": "8.23.1",
    "@types/supertest": "7.2.1",
    "drizzle-kit": "0.31.11",
    "oxlint": "1.85.0",
    "prettier": "3.9.9",
    "supertest": "7.3.0",
    "ts-loader": "9.6.2",
    "ts-node": "10.9.2",
    "tsconfig-paths": "4.2.0",
    "typescript": "6.0.3",
    "vitest": "5.0.2"
  },
  "type": "module"
}
