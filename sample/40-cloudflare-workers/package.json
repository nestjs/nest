{
  "name": "cloudflare-workers",
  "version": "1.0.0",
  "description": "Nest application served by Cloudflare Workers",
  "license": "MIT",
  "scripts": {
    "prebuild": "rimraf dist",
    "build": "tsc -p tsconfig.build.json",
    "format": "prettier --write \"src/**/*.ts\" \"e2e/**/*.ts\"",
    "start": "npm run build && wrangler dev",
    "deploy": "npm run build && wrangler deploy",
    "lint": "oxlint src --fix",
    "test:e2e": "npm run build && vitest run --config ./vitest.config.e2e.mts"
  },
  "dependencies": {
    "@nestjs/common": "12.2.0",
    "@nestjs/core": "12.2.0",
    "@nestjs/platform-cloudflare": "12.2.0",
    "@nestjs/platform-express": "12.2.0",
    "class-transformer": "0.5.1",
    "class-validator": "0.15.1",
    "reflect-metadata": "0.2.2",
    "rimraf": "6.1.3",
    "rxjs": "7.8.2"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "5.20261024.1",
    "@types/express": "5.0.6",
    "@types/node": "24.19.2",
    "oxlint": "1.89.0",
    "prettier": "3.9.10",
    "typescript": "5.9.3",
    "vitest": "5.0.5",
    "wrangler": "4.152.0"
  },
  "type": "module"
}
