{
  "name": "sql-typeorm",
  "version": "1.0.0",
  "description": "TypeORM integration with MySQL via @nestjs/typeorm",
  "license": "MIT",
  "scripts": {
    "prebuild": "rimraf dist",
    "build": "nest build",
    "format": "prettier --write \"src/**/*.ts\" \"test/**/*.ts\"",
    "start": "nest start",
    "start:dev": "nest start --watch",
    "start:debug": "nest start --debug --watch",
    "start:prod": "node dist/main",
    "lint": "oxlint src --fix",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:cov": "vitest run --coverage",
    "test:debug": "vitest --inspect-brk --no-file-parallelism",
    "test:e2e": "vitest run --config ./vitest.config.e2e.mts"
  },
  "dependencies": {
    "@nestjs/common": "12.4.2",
    "@nestjs/core": "12.4.1",
    "@nestjs/platform-express": "12.4.1",
    "@nestjs/typeorm": "12.0.3",
    "mysql2": "3.24.6",
    "reflect-metadata": "0.2.2",
    "rimraf": "6.1.4",
    "rxjs": "7.8.2",
    "typeorm": "1.1.2"
  },
  "devDependencies": {
    "@nestjs/cli": "12.0.12",
    "@nestjs/schematics": "12.0.13",
    "@nestjs/testing": "12.4.1",
    "@types/express": "5.0.6",
    "@types/node": "26.6.6",
    "@types/supertest": "7.2.1",
    "oxlint": "1.93.0",
    "prettier": "3.9.10",
    "sql.js": "1.15.2",
    "supertest": "7.3.2",
    "ts-loader": "9.6.2",
    "ts-node": "10.9.2",
    "tsconfig-paths": "4.2.0",
    "typescript": "7.0.2",
    "vitest": "5.1.0"
  },
  "type": "module"
}
